# WhatsApp Bot Configuration

# Owner
OWNER_NUMBER=6281234567890

# Bot Settings
BOT_NAME=WhatsApp Bot
BOT_PREFIX=.
BOT_MODE=public

# PPOB API (DigiFlazz example)
PPOB_API_KEY=your_api_key_here
PPOB_API_URL=https://api.digiflazz.com/v1
PPOB_USERNAME=your_username_here

# Timezone
TZ=Asia/Jakarta

# Node Environment
NODE_ENV=production
